{
  "all": true,
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "src/migrations/**",
    "src/seeders/**",
    "tests/**",
    "coverage/**",
    "node_modules/**",
    "ecosystem.config.json",
    "*.config.js"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov"
  ],
  "report-dir": "coverage",
  "temp-dir": ".nyc_output",
  "cache": true,
  "check-coverage": true,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 70
}