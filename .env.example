# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=microservice_template_dev

# Database Connection Pool
# Recommended: (CPU cores × 2) + disk count
# For microservice: 5-15 max, 2-3 min
DB_POOL_MAX=12
DB_POOL_MIN=3
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_POOL_EVICT=10000
DB_CONNECTION_TIMEOUT=5000
DB_RETRY_MAX=3

# CORS Configuration
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# Request Size Limits
REQUEST_SIZE_LIMIT=10mb

# Logging Configuration
LOGGING_ENABLED=true
LOGGING_MAX_FILE_SIZE=20m
LOGGING_MAX_FILES=30d

# Service Configuration
SERVICE_NAME=microservice-template

# Development/Testing
TEST_DB_NAME=microservice_template_test